# Usa Go 1.25 come richiesto da go.mod
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Installa git e build-base (gcc) per compilare SQLite con CGO
RUN apk add --no-cache git build-base

# Copia i file delle dipendenze e scarica i moduli
COPY go.mod go.sum ./
RUN go mod download

# Copia tutto il codice sorgente
COPY . .

# Abilita CGO e compila il main.go che si trova in cmd/webapi
ENV CGO_ENABLED=1
RUN go build -o webapi ./cmd/webapi

# Immagine Finale
FROM alpine:latest

WORKDIR /app

# Copia l'eseguibile compilato
COPY --from=builder /app/webapi .

# Assegna i permessi di esecuzione al file binario
RUN chmod +x ./webapi

# Espone la porta API
EXPOSE 3000

# Avvia il server
CMD ["./webapi"]
